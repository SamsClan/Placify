SECRET_KEY=mysecretkey
DATABASE_URL=sqlite:///instance/placement_portal.db

# Mailpit (local SMTP catcher) — run `mailpit` and open http://localhost:8025
# to view every email the app sends, without delivering anything to real inboxes.
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_USE_TLS=false
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=placify@demo.com

REDIS_URL=redis://127.0.0.1:6379/0
